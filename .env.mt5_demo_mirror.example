# ============================================================
# MT5 DEMO MIRROR — experimento espejo del CloudSim Crash 500
# ============================================================
# IMPORTANTE:
# - usa exclusivamente una cuenta Deriv MT5 DEMO dedicada;
# - NO publiques este archivo si contiene password;
# - el modo mirror congela internamente:
#   hybrid_long_only, M1, ATR14, riesgo 0.5%, SL 1.5 ATR, TP 2R, DD 12%.

MIRROR_SYMBOL=Crash 500 Index
MIRROR_START_BALANCE=100
MIRROR_WARMUP_CANDLES=4000
MIRROR_RECONNECT_SECONDS=5
MIRROR_MAX_MARGIN_USD=100
MIRROR_DATA_DIR=mirror_data

MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=Crash 500 Index

# Magic exclusivo para NO mezclar el mirror con el motor live normal.
MT5_MIRROR_MAGIC=20261001
MT5_MIRROR_COMMENT=DEMO_MIRROR

MT5_DEVIATION_POINTS=50
MT5_REQUIRE_DERIV_SERVER=true

# El mirror usa el WebSocket público de Deriv para generar las mismas velas
# que worker_simulation.py.
DERIV_PUBLIC_WS=wss://api.derivws.com/trading/v1/options/ws/public
